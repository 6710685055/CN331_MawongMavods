[run]
branch = True
source =
    accounts
    courses
    documents
    meetings
    notifications
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */admin.py
    */apps.py

[report]
fail_under = 80
show_missing = True
skip_covered = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
